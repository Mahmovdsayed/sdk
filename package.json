{
  "name": "@hirely/sdk",
  "version": "1.0.1",
  "description": "Official JavaScript and TypeScript SDK for connecting your Hirely portfolio to any website or application.",
  "type": "module",
  "exports": {
    ".": {
      "bun": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bunx tsgo --noEmit",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run typecheck && bun run build && bun run smoke && bun test",
    "release:patch": "npm version patch && git push --follow-tags && npm publish",
    "release:minor": "npm version minor && git push --follow-tags && npm publish",
    "release:major": "npm version major && git push --follow-tags && npm publish"
  },
  "keywords": [
    "hirely",
    "sdk",
    "portfolio",
    "typescript",
    "javascript",
    "api",
    "client",
    "nextjs",
    "react",
    "astro",
    "remix",
    "freelancer",
    "career",
    "ai"
  ],
  "author": {
    "name": "Hirely",
    "url": "https://hirely.cc"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirely/sdk.git"
  },
  "homepage": "https://hirely.cc",
  "bugs": {
    "url": "https://github.com/hirely/sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.4.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "latest",
    "typescript": "^7.0.2"
  }
}
